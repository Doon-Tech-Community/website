# Public - used by both server and any future client SDK
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=dtc-pokedex
NEXT_PUBLIC_APPWRITE_DATABASE_ID=dtc
NEXT_PUBLIC_APPWRITE_BUCKET_AVATARS=avatars

# Server-only - Appwrite API key with sessions.write plus the database/user/storage scopes used by admin actions
# Create in console: Project -> Overview -> Integrations -> API Keys
APPWRITE_API_KEY=

# Site URL used by metadata + sitemap (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
